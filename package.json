{
  "name": "gatso",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicacion web de control de gastos compartidos entre amigos (estilo Splitwise), con privacidad por diseno.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "drizzle-orm": "^0.45.2",
    "@neondatabase/serverless": "^1.1.0",
    "zod": "^4.4.3",
    "argon2": "^0.45.1",
    "jose": "^6.2.4",
    "nanoid": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "vitest": "^4.1.10"
  }
}
