# Base de datos (Neon serverless Postgres). Obtener en https://neon.tech o Vercel Storage.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Autenticacion
AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32+-bytes"
AUTH_COOKIE_NAME="gatso_session"

# Rate limiting (segundos minimos entre creaciones de gasto por usuario).
# Tambien se puede sobreescribir en runtime via la tabla app_config (clave: expense_creation_rate_limit_seconds).
RATE_LIMIT_EXPENSE_CREATION_SECONDS=30

# Entorno (NO fijar esta variable en Vercel: la establece automaticamente)
NODE_ENV="development"

# Importacion desde Splitwise (Fase 11, opcional). Registrar una app OAuth
# en https://dev.splitwise.com/ para obtener client id/secret; configurar
# callbacks distintos para desarrollo/Preview/Production.
SPLITWISE_CLIENT_ID=""
SPLITWISE_CLIENT_SECRET=""
# Clave AES-256-GCM en hexadecimal (32 bytes = 64 caracteres) para cifrar
# los tokens de Splitwise en reposo. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMPORT_ENCRYPTION_KEY=""
